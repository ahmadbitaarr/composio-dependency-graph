  "hardSeparations": [
    {
      "left": "gmail.thread_id",
      "right": "gmail.message_id",
      "reason": "Thread and message resources have different identifiers even when returned together."
    },
    {
      "left": "gmail.label_id",
      "right": "gmail.thread_id",
      "reason": "A label identifier cannot satisfy a thread identifier input."
    },
    {
      "left": "google.calendar_id",
      "right": "google.event_id",
      "reason": "A calendar identifies a container while an event identifies an item within a calendar."
    },
    {
      "left": "google.drive_file_id",
      "right": "gmail.message_id",
      "reason": "The identifiers belong to different Google services and resources."
    },
    {
      "left": "github.issue_number",
      "right": "github.pull_request_number",
      "reason": "Issues and pull requests may share numbering infrastructure but retain distinct resource semantics."
    },
    {
      "left": "github.workflow_id",
      "right": "github.workflow_run_id",
      "reason": "A workflow definition and an execution of that workflow are different resources."
    },
    {
      "left": "github.workflow_run_id",
      "right": "github.workflow_run_number",
      "reason": "The REST ID and sequential run number are not interchangeable."
    },
    {
      "left": "github.workflow_run_id",
      "right": "github.job_id",
      "reason": "A workflow run contains jobs, but the run ID is not a job ID."
    },
    {
      "left": "github.repository_id",
      "right": "github.repository_node_id",
      "reason": "The numeric REST repository ID and GraphQL node ID use different identity systems."
    },
    {
      "left": "github.release_id",
      "right": "github.release_asset_id",
      "reason": "A release and an asset attached to a release are separate resources."
    },
    {
      "left": "github.commit_sha",
      "right": "github.branch_ref",
      "reason": "A commit SHA identifies an immutable object while a branch ref is a movable name."
    }
  ]
